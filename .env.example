# Contact-form SMTP settings — set these in Coolify (Environment Variables).
# Use a cPanel mailbox you create (e.g. website@chesson-realty.com) so mail
# sends from your own domain and passes SPF/DKIM. Do NOT commit real values.

SMTP_HOST=mail.chesson-realty.com      # cPanel: Email Accounts > Connect Devices > Outgoing server
SMTP_PORT=465                          # 465 = SSL (secure), or 587 = STARTTLS
SMTP_SECURE=true                       # true for port 465, false for 587
SMTP_USER=website@chesson-realty.com   # the full mailbox address
SMTP_PASS=your-mailbox-password        # that mailbox's password

# Where inquiries are delivered. Can be his Gmail directly, OR a cPanel address
# that you forward to his Gmail (cPanel > Forwarders).
MAIL_TO=ChessonRealty@gmail.com

# From header — keep it on your own domain mailbox for best deliverability.
MAIL_FROM="Chesson Realty Website <website@chesson-realty.com>"

# Port the app listens on (Coolify maps this automatically).
PORT=3000
